+ALFWORLD_ACTION_TURN_MARKER = "Now it's your turn to take an action."
+ALFWORLD_ACTION_ONLY_SUFFIX = """Now it's your turn to take an action.
+Choose exactly one action verbatim from the admissible-action list.
+Return only <action>YOUR ACTION</action>. Do not include reasoning, commentary, or any other text.
+"""
+
+
+def use_action_only_instruction(prompt: str) -> str:
+    """Replace the legacy chain-of-thought request with a parse-safe action contract."""
+    marker_index = prompt.rfind(ALFWORLD_ACTION_TURN_MARKER)
+    if marker_index < 0:
+        raise ValueError("ALFWorld prompt has no action-turn marker")
+    return prompt[:marker_index] + ALFWORLD_ACTION_ONLY_SUFFIX
+
